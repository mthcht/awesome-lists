rule Trojan_Win64_ChickenStealer_AMTB_2147980241_0
{
    meta:
        author = "defender2yara"
        detection_name = "Trojan:Win64/ChickenStealer!AMTB"
        threat_id = "2147980241"
        type = "Trojan"
        platform = "Win64: Windows 64-bit platform"
        family = "ChickenStealer"
        severity = "Critical"
        signature_type = "SIGNATURE_TYPE_PEHSTR_EXT"
        threshold = "6"
        strings_accuracy = "High"
    strings:
        $x_2_1 = "SELECT host_key, name, encrypted_value, path, expires_utc, is_secure, is_httponly FROM cookies" ascii //weight: 2
        $x_3_2 = "ChickenStealer" ascii //weight: 3
        $x_1_3 = "This file was generated by ChickenStealer" ascii //weight: 1
        $x_1_4 = "ChickenStealer_Log.zip" ascii //weight: 1
    condition:
        (filesize < 20MB) and
        (
            ((1 of ($x_3_*) and 1 of ($x_2_*) and 1 of ($x_1_*))) or
            (all of ($x*))
        )
}

